# ==============================================================================
# VistaBridge Docker Environment Configuration
# Copy this file to .env before starting: cp docker.env.example .env
# ==============================================================================

# Application & Port Settings
PORT=3007
HOSTNAME=0.0.0.0
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Docker Hub Image repository (Default: pbokaderottengrapes/vistabridge:latest)
DOCKER_IMAGE=pbokaderottengrapes/vistabridge:latest

# Database Configuration
DB_TYPE=sqlite
SQLITE_DB_PATH=/app/data/geovista.db

# GeoServer Configuration:
# - If GeoServer runs on the host machine: http://host.docker.internal:8080/geoserver
# - If GeoServer runs on an external IP or domain: https://geoserver.example.com/geoserver
GEOSERVER_URL=http://host.docker.internal:8080/geoserver
NEXT_PUBLIC_GEOSERVER_URL=http://host.docker.internal:8080/geoserver

# Vector Tile Server (pg_tileserv) Configuration:
NEXT_PUBLIC_TILESERV_URL=http://host.docker.internal:7800

# Next.js API Base URL
NEXT_PUBLIC_API_URL=/api

# Analytics Service URL
NEXT_PUBLIC_ANALYTICS_URL=http://host.docker.internal:8000

# Authentication Secret:
# Leave blank to automatically generate and persist a secure key in SQLite on first boot
JWT_SECRET=
