# ==============================================================================
# VistaBridge Environment Configuration Template
# Copy this file to .env before starting: cp env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & NETWORK RUNTIME SETTINGS
# ------------------------------------------------------------------------------
PORT=3007
HOSTNAME=0.0.0.0
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Nginx Reverse Proxy Settings (Standard Port 80)
HTTP_PORT=80
# Set your custom domain here (e.g. vistabridge.example.com). Use '_' to allow access via any Server IP
DOMAIN=_

# ------------------------------------------------------------------------------
# 2. DOCKER HUB IMAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Official Docker Hub image repository
DOCKER_IMAGE=rottengrapesprivatelimited/vistabridge:latest

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (SQLITE / LIBSQL)
# ------------------------------------------------------------------------------
DB_TYPE=sqlite
SQLITE_DB_PATH=./data/geovista.db

# ------------------------------------------------------------------------------
# 4. GEOSERVER INTEGRATION SETTINGS
# ------------------------------------------------------------------------------
# Backend GeoServer API URL (used by Next.js server-side API proxy):
# - If GeoServer runs on the host machine inside Docker: http://host.docker.internal:8080/geoserver
# - If GeoServer runs on an external IP or domain: https://geoserver.example.com/geoserver
GEOSERVER_URL=http://host.docker.internal:8080/geoserver

# Frontend Client GeoServer URL (used by browser for WMS/WFS map layer requests):
NEXT_PUBLIC_GEOSERVER_URL=http://host.docker.internal:8080/geoserver

# ------------------------------------------------------------------------------
# 5. VECTOR TILE SERVER (pg_tileserv) SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TILESERV_URL=http://host.docker.internal:7800

# ------------------------------------------------------------------------------
# 6. ANALYTICS & RASTER PROCESSING SERVICE
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_URL=http://host.docker.internal:8000

# ------------------------------------------------------------------------------
# 7. NEXT.JS API BASE ROUTE
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=/api

# ------------------------------------------------------------------------------
# 8. JWT AUTHENTICATION SECRET
# ------------------------------------------------------------------------------
# Cryptographic secret for signing session tokens (leave blank to auto-generate)
JWT_SECRET=g4SwHtTa5sXzq8xDpfDik69DGOX9z6ahr6O2IPcwCcIWclnl8uVNE3ePLM5NVJ2i/G785wEDvdmZN9ZqWhQDOw==
