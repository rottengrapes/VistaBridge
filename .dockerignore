# ==============================================================================
# VistaBridge Docker Ignore File
# Excludes unnecessary files to keep Docker build context clean and minimal
# ==============================================================================

# Dependencies
node_modules/
.pnp/
.pnp.js

# Build and runtime outputs
.next/
out/
build/
dist/

# Testing and coverage artifacts
coverage/
.nyc_output/
coverage-summary.md
uat-report.md
pat-report.md
report_html.html
report_md.md
report_json.json
semgrep.sarif
.zap/

# Git and CI/CD metadata
.git/
.github/
.gitignore

# Environment and local secret files
.env
.env*.local

# SQLite local data directory (persisted via Docker volumes)
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# GeoServer / Spatial test files
geodata/
geoserver_data/
postgres_data/
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.tif
*.tiff
*.geojson

# Logs & temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
Thumbs.db

